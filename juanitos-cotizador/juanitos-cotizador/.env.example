# Google Apps Script web app URL (ends in /exec). See README, step 2.
APPS_SCRIPT_URL=
# Shared secret; must match the TOKEN script property in Apps Script.
SHEETS_TOKEN=

# Chat assistant. Leave as "none" until a model is chosen: the chat answers from lib/faq.js.
# none | openai-compatible | anthropic
LLM_PROVIDER=none
LLM_API_KEY=
# openai-compatible only. Examples:
#   Groq (hosted open-source models): https://api.groq.com/openai/v1   model: llama-3.1-8b-instant
#   OpenRouter:                        https://openrouter.ai/api/v1
#   Self-hosted Ollama:                https://your-server/v1          model: llama3.1:8b
LLM_BASE_URL=
LLM_MODEL=
